---
import { projects } from "../data/projects";
import OtherWork from "./OtherWork.astro";
import PortfolioEvolution from "./PortfolioEvolution.astro";
---

<section
  class="selected-work"
  id="selected-work"
  aria-labelledby="selected-work-title"
>
  <header class="section-heading">
    <div class="section-heading__label">
      <span class="section-number">01</span>

      <h2 id="selected-work-title" class="eyebrow">
        Selected Work
      </h2>
    </div>

    <div class="section-heading__intro">
      <p>
        Selected engineering work across production products,
        platforms and independent projects.
      </p>
    </div>
  </header>

  <div class="projects">
    {projects.map((project) => (
      <details class="project">
        <summary class="project-summary">
          <span class="project-number">
            {project.number}
          </span>

          <span class="project-main">
            <span class="project-main__title">
              {project.title}
            </span>

            <span class="project-subtitle">
              <span>{project.client}</span>
              <span>{project.type}</span>
            </span>
          </span>

          <span class="project-date">
            {project.dates}
          </span>

          <span class="project-toggle" aria-hidden="true">
            <span class="plus">+</span>
            <span class="minus">−</span>
          </span>
        </summary>

        <article class="project-details">
          <div class="project-introduction">
            <div class="detail-label">
              <p class="eyebrow">Overview</p>
            </div>

            <div class="project-description">
              <p class="lead">
                {project.description}
              </p>

              <div class="project-role">
                <p class="eyebrow">Role</p>

                <p>
                  {project.role}
                </p>
              </div>
              {
                (project.url || project.links?.length) && (
                  <div class="project-link">
                    <p class="eyebrow">Project</p>

                    {project.links?.length ? (
                      <div class="project-links">
                        {project.links.map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <span>{link.label}</span>
                            <span aria-hidden="true">↗</span>
                          </a>
                        ))}
                      </div>
                    ) : project.url ? (
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span>
                          {project.url
                            .replace(/^https?:\/\/?/, "")
                            .replace(/\/$/, "")}
                        </span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : null}
                  </div>
                )
              }
            </div>
          </div>

          <div class="project-approach">
            <div class="detail-label">
              <p class="eyebrow">Approach</p>
            </div>

            <div class="approach-list">
              {project.approach.map((item) => (
                <article class="approach-item">
                  <span class="approach-number">
                    {item.number}
                  </span>

                  <div class="approach-content">
                    <h4>{item.title}</h4>

                    <p>
                      {item.text}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="project-technology">
            <div class="detail-label">
              <p class="eyebrow">Technology</p>
            </div>

            <ul>
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          </div>
        </article>
      </details>
    ))}
  </div>

  <OtherWork />
  <PortfolioEvolution />
</section>

<style>
  .selected-work {
    margin-top: 12rem;
  }

  .section-heading {
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 4rem;
    grid-template-columns:
      minmax(180px, 1fr)
      minmax(300px, 0.8fr);
    padding-bottom: 3rem;
  }

  .section-heading__label {
    align-items: baseline;
    display: flex;
    gap: 1.5rem;
  }

  .section-heading__intro {
    max-width: 38rem;
  }

  .section-heading__intro p {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .project {
    border-bottom: 1px solid var(--line);
  }

  .project-summary {
    align-items: start;
    column-gap: 2rem;
    cursor: pointer;
    display: grid;
    grid-template-columns:
      4rem
      minmax(0, 1fr)
      minmax(120px, 0.35fr)
      2rem;
    list-style: none;
    padding: 2.75rem 0;
  }

  .project-summary::-webkit-details-marker {
    display: none;
  }

  .project-summary::marker {
    display: none;
  }

  .project-summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.5rem;
  }

  .project-number {
    color: var(--muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding-top: 0.25rem;
  }

  .project-main {
    display: block;
  }

  .project-main__title {
    display: block;
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    transition:
      transform 250ms ease,
      opacity 250ms ease;
  }

  .project-summary:hover .project-main__title {
    transform: translateX(0.4rem);
  }

  .project-subtitle {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.75rem;
    gap: 1rem;
    line-height: 1.4;
    margin-top: 1rem;
  }

  .project-subtitle span + span::before {
    content: "·";
    margin-right: 1rem;
  }

  .project-date {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.4;
    padding-top: 0.3rem;
    text-align: right;
  }

  .project-toggle {
    border: 1px solid var(--foreground);
    border-radius: 50%;
    display: grid;
    font-size: 1rem;
    height: 2rem;
    line-height: 1;
    place-items: center;
    position: relative;
    transition:
      background 250ms ease,
      color 250ms ease,
      transform 250ms ease;
    width: 2rem;
  }

  .project-summary:hover .project-toggle {
    transform: rotate(90deg);
  }

  .minus {
    display: none;
  }

  .project[open] .plus {
    display: none;
  }

  .project[open] .minus {
    display: block;
  }

  .project[open] .project-toggle {
    color: var(--background);
    background: var(--foreground);
  }

  .project-details {
    padding: 0 0 5rem 6rem;
  }

  .project-introduction,
  .project-approach,
  .project-technology {
    display: grid;
    gap: 4rem;
    grid-template-columns:
      minmax(180px, 0.7fr)
      minmax(0, 1fr);
    padding-top: 2.5rem;
  }

  .project-introduction {
    padding-top: 0;
  }

  .project-description {
    max-width: 48rem;
  }

  .lead {
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    letter-spacing: -0.015em;
    line-height: 1.5;
  }

  .project-role {
    margin-top: 3rem;
    max-width: 36rem;
  }

  .project-role .eyebrow {
    margin-bottom: 0.75rem;
  }

  .project-role p:last-child {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .project-link {
    margin-top: 2rem;
  }

  .project-link .eyebrow {
    margin-bottom: 0.75rem;
  }

  .project-link a {
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: inherit;
    display: inline-flex;
    font-size: 0.85rem;
    gap: 0.5rem;
    line-height: 1.5;
    text-decoration: none;
    transition:
      gap 200ms ease,
      border-color 200ms ease;
  }

  .project-link a:hover {
    border-color: currentColor;
    gap: 0.8rem;
  }

  .project-link a span:last-child {
    font-size: 1rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .approach-list {
    border-top: 1px solid var(--line);
  }

  .approach-item {
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 3rem minmax(0, 1fr);
    padding: 1.5rem 0;
  }

  .approach-number {
    color: var(--muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    padding-top: 0.15rem;
  }

  .approach-content h4 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .approach-content p {
    color: var(--muted-2);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 42rem;
  }

  .project-technology ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .project-technology li {
    border: 1px solid var(--line);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    padding: 0.45rem 0.75rem;
  }

  @media (max-width: 800px) {
    .selected-work {
      margin-top: 8rem;
    }

    .section-heading {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }

    .section-heading__intro {
      max-width: 32rem;
    }

    .project-summary {
      column-gap: 1rem;
      grid-template-columns: 2.5rem minmax(0, 1fr) 2rem;
      padding: 2rem 0;
    }

    .project-date {
      grid-column: 2;
      grid-row: 2;
      padding-top: 0.75rem;
      text-align: left;
    }

    .project-main__title {
      font-size: clamp(1.5rem, 7vw, 2.25rem);
    }

    .project-details {
      padding: 0 0 3rem 3.5rem;
    }

    .project-introduction,
    .project-approach,
    .project-technology {
      gap: 1.25rem;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 500px) {
    .project-details {
      padding-left: 0;
    }

    .project-summary {
      grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    }

    .project-number {
      font-size: 0.65rem;
    }

    .project-subtitle {
      flex-direction: column;
      gap: 0.25rem;
    }

    .project-subtitle span + span::before {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-main__title,
    .project-toggle,
    .project-link a {
      transition: none;
    }

    .project-summary:hover .project-main__title {
      transform: none;
    }

    .project-summary:hover .project-toggle {
      transform: none;
    }

    .project-link a:hover {
      gap: 0.5rem;
    }
  }
</style>